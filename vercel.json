{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string from Neon",
      "required": true
    },
    "GEMINI_API_KEY": {
      "description": "Google Gemini API Key",
      "required": true
    },
    "NEXTAUTH_URL": {
      "description": "Full URL of your Vercel deployment (e.g., https://your-app.vercel.app)",
      "required": true
    },
    "NEXTAUTH_SECRET": {
      "description": "Secret for NextAuth session encryption",
      "required": true
    }
  }
}
